<?xml version="1.0" encoding="utf-8"?>
<!-- Back up presets, calibration and settings (DataStore). Recently played entries reference
     content URIs that are not valid on another device, so they are restored but simply fail to
     open and are pruned. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
